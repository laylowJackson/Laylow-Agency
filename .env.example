# Add your own credentials locally. Never commit your .env file.
OPENAI_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
OPENAI_MODEL=gpt-4o-mini

# observe: start workers and dashboard with no external requests
# analyze: current quotes + AI analysis; no orders
# paper: Alpaca paper orders, also requires the explicit switch below
LAYLOW_MODE=observe
LAYLOW_ALLOW_PAPER_ORDERS=false
LAYLOW_DASHBOARD_HOST=127.0.0.1
LAYLOW_DASHBOARD_PORT=5000
# Optional directory, relative to the project or absolute
LAYLOW_DATA_DIR=
